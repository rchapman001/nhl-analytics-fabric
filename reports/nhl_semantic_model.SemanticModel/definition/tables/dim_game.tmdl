table dim_game
	lineageTag: ae90157d-9dd1-4b7d-af11-0f30581cc3b6
	sourceLineageTag: [dbo].[dim_game]

	measure 'Home Team Abbrev' =
			
			CALCULATE (
			    MAX ( dim_team[team_abbrev] ),
			    TREATAS (
			        VALUES ( dim_game[home_team_id] ),
			        dim_team[team_id]
			    )
			)
		lineageTag: 4d0bf9d1-d184-4082-bb8e-c3ee1dd9e8be

		changedProperty = Name

	measure 'Away Team Abbrev' =
			
			CALCULATE (
			    MAX ( dim_team[team_abbrev] ),
			    TREATAS (
			        VALUES ( dim_game[away_team_id] ),
			        dim_team[team_id]
			    )
			)
		lineageTag: 773ed9a0-a416-41af-916c-06cb4858bb2c

		changedProperty = Name

	measure 'Game Date' =
			
			CALCULATE (
			    MAX ( dim_date[full_date] ),
			    TREATAS (
			        VALUES ( dim_game[date_id] ),
			        dim_date[date_id]
			    )
			)
		formatString: General Date
		lineageTag: 9c0d6aec-3e26-4f7a-8a86-85719faeb92c

		changedProperty = Name

	measure Score =
			
			MAX ( dim_game[away_team_score] )
			    & " - "
			    & MAX ( dim_game[home_team_score] )
		lineageTag: ec4d1912-d544-4fbe-8c11-4441165e9784

		changedProperty = Name

