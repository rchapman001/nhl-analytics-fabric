table fact_player_game_stats
	lineageTag: 7763986a-e1dc-4306-bbeb-fbea0344eb38
	sourceLineageTag: [dbo].[fact_player_game_stats]

	measure Opponent =
			
			VAR PlayerID =
			    SELECTEDVALUE ( fact_player_game_stats[player_id] )
			
			VAR GameID =
			    SELECTEDVALUE ( fact_player_game_stats[game_id] )
			
			VAR PlayerTeamID =
			    CALCULATE (
			        MAX ( fact_rosters[team_id] ),
			        FILTER (
			            ALL ( fact_rosters ),
			            fact_rosters[player_id] = PlayerID
			        )
			    )
			
			VAR HomeTeamID =
			    LOOKUPVALUE (
			        dim_game[home_team_id],
			        dim_game[game_id], GameID
			    )
			
			VAR AwayTeamID =
			    LOOKUPVALUE (
			        dim_game[away_team_id],
			        dim_game[game_id], GameID
			    )
			
			VAR OpponentTeamID =
			    SWITCH (
			        TRUE (),
			        PlayerTeamID = HomeTeamID, AwayTeamID,
			        PlayerTeamID = AwayTeamID, HomeTeamID,
			        BLANK ()
			    )
			
			RETURN
			    LOOKUPVALUE (
			        dim_team[team_abbrev],
			        dim_team[team_id], OpponentTeamID
			    )
		lineageTag: 29cb5970-8a33-4cbb-b438-f9e5f821d0ab

		changedProperty = Name

