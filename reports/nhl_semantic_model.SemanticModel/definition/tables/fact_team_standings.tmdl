table fact_team_standings
	lineageTag: 95aa8c71-0655-4ba4-97ad-f9b05cf4b1d9
	sourceLineageTag: [dbo].[fact_team_standings]

	measure 'Is Latest Date' =
			
			VAR LatestDate =
			    CALCULATE (
			        MAX ( fact_team_standings[date_id]),
			        ALL ( fact_team_standings )
			    )
			RETURN
			    IF (
			        MAX ( fact_team_standings[date_id] ) = LatestDate,
			        1,
			        0
			    )
		formatString: 0
		lineageTag: 3345c77f-d590-4863-8c30-94a8926e8c02

		changedProperty = Name

